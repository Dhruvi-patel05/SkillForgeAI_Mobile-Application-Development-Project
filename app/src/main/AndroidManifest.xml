<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet Permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network State -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ Notification Permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SkillForgeAIApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkillForgeAI"
        tools:targetApi="34">

        <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />

        </provider>

        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".services.FCMService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

        <!-- Splash Screen -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity" />

        <!-- Authentication -->
        <activity
            android:name=".ui.auth.LoginActivity" />

        <activity
            android:name=".ui.auth.RegisterActivity" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity" />

        <!-- Dashboard -->
        <activity
            android:name=".ui.dashboard.DashboardActivity" />

        <!-- Courses -->
        <activity
            android:name=".ui.courses.CoursesActivity" />

        <activity
            android:name=".ui.courses.CourseDetailsActivity" />

        <!-- AI Module -->
        <activity
            android:name=".ui.ai.AIMentorActivity" />

        <activity
            android:name=".ui.ai.SkillGapActivity" />

        <activity
            android:name=".ui.ai.CareerPredictionActivity" />

        <activity
            android:name=".ui.ai.RoadmapGeneratorActivity" />

        <activity
            android:name=".ui.ai.MockInterviewAIActivity" />

        <!-- Resume -->
        <activity
            android:name=".ui.resume.ResumeBuilderActivity" />

        <activity
            android:name=".ui.resume.ResumeAnalyzerActivity" />

        <activity
            android:name=".ui.resume.ResumeTemplatesActivity" />

        <activity
            android:name=".ui.resume.ResumePreviewActivity" />

        <!-- Placement -->
        <activity
            android:name=".ui.placement.PlacementActivity" />

        <activity
            android:name=".ui.placement.AptitudeActivity" />

        <activity
            android:name=".ui.placement.CodingPracticeActivity" />

        <activity
            android:name=".ui.placement.MockInterviewActivity" />

        <activity
            android:name=".ui.placement.CompanyWisePrepActivity" />

        <activity
            android:name=".ui.placement.PlacementScoreActivity" />

        <!-- Skill Tracker -->
        <activity
            android:name=".ui.skilltracker.SkillTrackerActivity" />

        <!-- Automation -->
        <activity
            android:name=".ui.automation.AutomationActivity" />

        <activity
            android:name=".ui.automation.AutomationDetailsActivity" />

        <!-- Notifications -->
        <activity
            android:name=".ui.notifications.NotificationsActivity" />

        <!-- Profile -->
        <activity
            android:name=".ui.profile.ProfileActivity" />

        <activity
            android:name=".ui.profile.EditProfileActivity" />

        <activity
            android:name=".ui.profile.SettingsActivity" />

    </application>

</manifest>