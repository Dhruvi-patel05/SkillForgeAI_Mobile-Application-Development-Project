<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resume Builder"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnAnalyzeResume"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Analyze Resume"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnTemplates"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Resume Templates"
        app:layout_constraintTop_toBottomOf="@id/btnAnalyzeResume"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnPreviewResume"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Resume Preview"
        app:layout_constraintTop_toBottomOf="@id/btnTemplates"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>